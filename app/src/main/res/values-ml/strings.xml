    <string name="onboarding_permission_mic_title">മൈക്രോഫോൺ</string>
    <string name="onboarding_permission_mic_body">iTantra നിങ്ങളെ കേട്ട് ടെക്സ്റ്റാക്കി മാറ്റാൻ — ഒന്നും ഫോണിന് പുറത്ത് പോകുന്നില്ല.</string>
    <string name="onboarding_permission_notif_title">അറിയിപ്പുകൾ</string>
