    <string name="onboarding_step1_title">Speak your language</string>
    <string name="onboarding_step1_body">iTantra understands and speaks 10 Indian languages, offline.</string>
    <string name="onboarding_step2_title">Works without network or internet</string>
    <string name="onboarding_step2_body">Phone talks to phone directly over Wi‑Fi or Bluetooth. Text is about 800× lighter than voice, so a message gets through where a call can’t.</string>
    <string name="onboarding_step3_title">Built on Indian open AI</string>
    <string name="onboarding_step3_body">Speech recognition by ARTPARK @ IISc Bengaluru (SraVaani). Voices by SPRING Lab @ IIT Madras (Indic‑Mio) and AI4Bharat @ IIT Madras (Rasa).</string>
    <string name="onboarding_permissions_title">A couple of permissions</string>
    <string name="onboarding_permission_mic_title">Microphone</string>
    <string name="onboarding_permission_mic_body">So iTantra can hear you and turn your speech into text — nothing leaves the phone.</string>
    <string name="onboarding_permission_notif_title">Notifications</string>
    <string name="onboarding_permission_notif_body">So the walkie‑talkie keeps running and shows its status while your screen is off.</string>

